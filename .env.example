# Copy this file to .env for local development:
#   cp .env.example .env
#
# scripts/dev.sh loads the resulting .env before starting Docker, the frontend
# build, and Spring Boot. Docker Compose also reads it automatically.
# Never commit .env — it is intentionally ignored by Git.

# ---- Application ----
SPRING_PROFILES_ACTIVE=dev
PORT=8080
FRONTEND_URL=http://localhost:8080

# Mobile dev does not need a fixed API URL. Expo derives this computer's LAN IP
# so a physical device can reach the locally running Spring Boot API. Use
# `cd mobile && npm run start:test` when the local app should call the deployed
# https://myskoolclub.com/api endpoint instead.

# The frontend normally calls the API using the same host that served it.
# Use http://localhost:8080/api only when running Vite separately without its
# configured development proxy.
VITE_API_URL=/api

# ---- Local PostgreSQL ----
# These values are shared by Docker Compose and application-dev.properties.
POSTGRES_DB=myskoolclub_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- Authentication ----
# Use a development-only value of at least 32 characters. Production uses a
# different secret stored in Google Secret Manager.
JWT_SECRET=local-development-jwt-secret-change-me
JWT_EXPIRATION_MS=86400000

# ---- Email verification / local SMTP ----
# Keep verification disabled for normal local development. To test the full
# verification-code flow, set this to true and start the stack; MailHog receives
# messages at http://localhost:8025 without sending real email.
EMAIL_VERIFICATION_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_TIMEOUT_MS=10000
MAIL_FROM=support@myskoolclub.com

# ---- Optional OpenAI receipt scanning ----
# Leave blank to disable receipt scanning locally. Add a development OpenAI API
# key to exercise the scanner; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ---- Production / GCP ----
# Cloud Run and Cloud SQL values are managed by scripts/config.sh and Google
# Secret Manager. They do not belong in the local .env file.
