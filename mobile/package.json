{
  "name": "my-skool-club-mobile",
  "version": "2.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "APP_ENV=dev EXPO_PUBLIC_APP_ENV=dev expo start",
    "start:test": "APP_ENV=test EXPO_PUBLIC_APP_ENV=test EXPO_PUBLIC_API_URL=https://myskoolclub.com/api expo start",
    "start:prod": "APP_ENV=prod EXPO_PUBLIC_APP_ENV=prod EXPO_PUBLIC_API_URL=https://myskoolclub.com/api expo start",
    "prebuild:dev": "APP_ENV=dev EXPO_PUBLIC_APP_ENV=dev expo prebuild --clean",
    "prebuild:test": "APP_ENV=test EXPO_PUBLIC_APP_ENV=test EXPO_PUBLIC_API_URL=https://myskoolclub.com/api expo prebuild --clean",
    "prebuild:prod": "APP_ENV=prod EXPO_PUBLIC_APP_ENV=prod EXPO_PUBLIC_API_URL=https://myskoolclub.com/api expo prebuild --clean",
    "android": "npm run android:dev",
    "android:dev": "npm run prebuild:dev && APP_ENV=dev EXPO_PUBLIC_APP_ENV=dev expo run:android",
    "android:test": "npm run prebuild:test && APP_ENV=test EXPO_PUBLIC_APP_ENV=test EXPO_PUBLIC_API_URL=https://myskoolclub.com/api expo run:android",
    "ios": "npm run ios:dev",
    "ios:dev": "npm run prebuild:dev && APP_ENV=dev EXPO_PUBLIC_APP_ENV=dev expo run:ios",
    "ios:test": "npm run prebuild:test && APP_ENV=test EXPO_PUBLIC_APP_ENV=test EXPO_PUBLIC_API_URL=https://myskoolclub.com/api expo run:ios",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:simulator": "eas build --profile development-simulator --platform ios",
    "build:test:dev-client": "eas build --profile test-development --platform all",
    "build:test": "eas build --profile test --platform all",
    "build:test:simulator": "eas build --profile test-simulator --platform ios",
    "build:prod": "eas build --profile production --platform all",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:ci": "jest --config jest.ci.config.js --ci --coverage --runInBand",
    "e2e:smoke": "maestro test e2e/maestro/smoke",
    "e2e:smoke:public": "maestro test e2e/maestro/smoke/01-public-auth.yaml",
    "e2e:smoke:member": "maestro test e2e/maestro/smoke/02-member-tabs.yaml",
    "e2e:smoke:admin": "maestro test e2e/maestro/smoke/03-admin-entry-points.yaml"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "axios": "^1.7.2",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.18.0",
    "lucide-react-native": "^1.41.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.12.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  }
}
