{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_ENV": "dev",
        "EXPO_PUBLIC_APP_ENV": "dev"
      },
      "node": "22.16.0"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "node": "22.16.0"
    },
    "test": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_ENV": "test",
        "EXPO_PUBLIC_APP_ENV": "test",
        "EXPO_PUBLIC_API_URL": "https://myskoolclub.com/api"
      },
      "node": "22.16.0"
    },
    "test-development": {
      "extends": "test",
      "developmentClient": true,
      "node": "22.16.0"
    },
    "test-simulator": {
      "extends": "test-development",
      "ios": {
        "simulator": true
      },
      "node": "22.16.0"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_ENV": "prod",
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_API_URL": "https://myskoolclub.com/api"
      },
      "node": "22.16.0"
    },
    "ci-smoke": {
      "extends": "test",
      "developmentClient": false,
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6800048941"
      }
    },
    "beta": {
      "ios": {
        "ascAppId": "6800048941"
      }
    }
  }
}
